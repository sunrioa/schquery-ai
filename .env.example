# Copy values into your shell, IDE run configuration, Docker Compose, or a local .env file.
# Do not commit real secrets.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/schqueryai?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# DashScope / OpenAI-compatible AI service
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v1
DASHSCOPE_EMBEDDING_DIMENSIONS=1536

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=schqueryai
QDRANT_USE_TLS=false

# Search and MCP
SEARCH_API_KEY=
SEARCH_ENGINE=baidu
TAVILY_API_KEY=

# Email
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET=files

# JWT and local tools
JWT_SECRET_KEY=change-this-jwt-secret-key-at-least-32-bytes
FFMPEG_PATH=ffmpeg

# Widget
WIDGET_SITE_KEY=demo-site-key
WIDGET_TITLE=SchQueryAI
WIDGET_ALLOWED_ORIGIN=http://localhost:8080
